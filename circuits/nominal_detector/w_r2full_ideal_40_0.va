`include "constants.vams"
`include "disciplines.vams"
module meter(src,load);
inout src,load;electrical src,load;branch(src,load) b;
parameter integer CH=0;
real e,g,r,p,ep,gp,rp;integer slot;
analog begin
V(b)<+0;p=V(load)*I(b);e=idt(p,0);g=idt(p>0?p:0,0);r=idt(p<0?-p:0,0);
@(initial_step) begin ep=0;gp=0;rp=0;slot=0;end
@(timer(2.5n,2.5n)) begin $strobe("ENERGY,%d,%d,%.15g,%.15g,%.15g",slot,CH,e-ep,g-gp,r-rp);ep=e;gp=g;rp=r;slot=slot+1;end
end
endmodule
module stimulus(P,N,CR,WR,AR,PP,PN,NP,NN,Q,QB,VP1,VN1,VP2,VN2);
output P,N,CR,WR,AR;input PP,PN,NP,NN,Q,QB,VP1,VN1,VP2,VN2;
electrical P,N,CR,WR,AR,PP,PN,NP,NN,Q,QB,VP1,VN1,VP2,VN2;
real cm,d,clk,win,acq,ph,lfar,lnear;integer slot,code;
analog begin
@(initial_step)begin cm=0.6;d=0;clk=0;win=1;acq=0;slot=0;lfar=0;lnear=0;end
@(timer(20p,2.5n))begin
case(slot)
0:begin cm=0.600000000;d=0.000000000;end
1:begin cm=0.000000000;d=0.000000000;end
2:begin cm=0.005000000;d=0.000000000;end
3:begin cm=0.010000000;d=0.000000000;end
4:begin cm=0.012000000;d=0.000000000;end
5:begin cm=0.015000000;d=0.000000000;end
6:begin cm=0.020000000;d=0.000000000;end
7:begin cm=0.020000000;d=-0.036000000;end
8:begin cm=0.020000000;d=0.036000000;end
9:begin cm=0.022000000;d=0.000000000;end
10:begin cm=0.022000000;d=-0.044000000;end
11:begin cm=0.022000000;d=-0.036000000;end
12:begin cm=0.022000000;d=0.036000000;end
13:begin cm=0.022000000;d=0.044000000;end
14:begin cm=0.025000000;d=0.000000000;end
15:begin cm=0.025000000;d=-0.044000000;end
16:begin cm=0.025000000;d=-0.036000000;end
17:begin cm=0.025000000;d=0.036000000;end
18:begin cm=0.025000000;d=0.044000000;end
19:begin cm=0.030000000;d=0.000000000;end
20:begin cm=0.030000000;d=-0.044000000;end
21:begin cm=0.030000000;d=-0.036000000;end
22:begin cm=0.030000000;d=0.036000000;end
23:begin cm=0.030000000;d=0.044000000;end
24:begin cm=0.040000000;d=0.000000000;end
25:begin cm=0.040000000;d=-0.044000000;end
26:begin cm=0.040000000;d=-0.036000000;end
27:begin cm=0.040000000;d=0.036000000;end
28:begin cm=0.040000000;d=0.044000000;end
29:begin cm=0.050000000;d=0.000000000;end
30:begin cm=0.050000000;d=-0.044000000;end
31:begin cm=0.050000000;d=-0.036000000;end
32:begin cm=0.050000000;d=0.036000000;end
33:begin cm=0.050000000;d=0.044000000;end
34:begin cm=0.100000000;d=0.000000000;end
35:begin cm=0.100000000;d=-0.044000000;end
36:begin cm=0.100000000;d=-0.036000000;end
37:begin cm=0.100000000;d=0.036000000;end
38:begin cm=0.100000000;d=0.044000000;end
39:begin cm=0.150000000;d=0.000000000;end
40:begin cm=0.150000000;d=-0.044000000;end
41:begin cm=0.150000000;d=-0.036000000;end
42:begin cm=0.150000000;d=0.036000000;end
43:begin cm=0.150000000;d=0.044000000;end
44:begin cm=0.200000000;d=0.000000000;end
45:begin cm=0.200000000;d=-0.044000000;end
46:begin cm=0.200000000;d=-0.036000000;end
47:begin cm=0.200000000;d=0.036000000;end
48:begin cm=0.200000000;d=0.044000000;end
49:begin cm=0.250000000;d=0.000000000;end
50:begin cm=0.250000000;d=-0.044000000;end
51:begin cm=0.250000000;d=-0.036000000;end
52:begin cm=0.250000000;d=0.036000000;end
53:begin cm=0.250000000;d=0.044000000;end
54:begin cm=0.300000000;d=0.000000000;end
55:begin cm=0.300000000;d=-0.044000000;end
56:begin cm=0.300000000;d=-0.036000000;end
57:begin cm=0.300000000;d=0.036000000;end
58:begin cm=0.300000000;d=0.044000000;end
59:begin cm=0.350000000;d=0.000000000;end
60:begin cm=0.350000000;d=-0.044000000;end
61:begin cm=0.350000000;d=-0.036000000;end
62:begin cm=0.350000000;d=0.036000000;end
63:begin cm=0.350000000;d=0.044000000;end
64:begin cm=0.400000000;d=0.000000000;end
65:begin cm=0.400000000;d=-0.044000000;end
66:begin cm=0.400000000;d=-0.036000000;end
67:begin cm=0.400000000;d=0.036000000;end
68:begin cm=0.400000000;d=0.044000000;end
69:begin cm=0.450000000;d=0.000000000;end
70:begin cm=0.450000000;d=-0.044000000;end
71:begin cm=0.450000000;d=-0.036000000;end
72:begin cm=0.450000000;d=0.036000000;end
73:begin cm=0.450000000;d=0.044000000;end
74:begin cm=0.500000000;d=0.000000000;end
75:begin cm=0.500000000;d=-0.044000000;end
76:begin cm=0.500000000;d=-0.036000000;end
77:begin cm=0.500000000;d=0.036000000;end
78:begin cm=0.500000000;d=0.044000000;end
79:begin cm=0.550000000;d=0.000000000;end
80:begin cm=0.550000000;d=-0.044000000;end
endcase
lfar=0;lnear=0;
end
@(timer(40p,2.5n))acq=1;
@(timer(250p,2.5n))clk=1;
@(timer(750p,2.5n))win=0;
@(timer(780p,2.5n))acq=0;
@(timer(900p,2.5n))clk=0;
@(timer(1200p,2.5n))win=1;
V(P)<+transition(cm+d/2,0,10p,10p);V(N)<+transition(cm-d/2,0,10p,10p);
V(CR)<+transition(1.2*clk,0,10p,10p);V(WR)<+transition(1.2*win,0,10p,10p);V(AR)<+transition(1.2*acq,0,10p,10p);
@(timer(240p,2.5n))$strobe("BIASED,%d,%.15g,%.15g,%.15g,%.15g",slot,V(VP1),V(VN1),V(VP2),V(VN2));
@(timer(0.25p,0.25p))begin
ph=$abstime-floor($abstime/2.5n)*2.5n;
if(ph>255p && ph<1190p)begin
if(!(V(Q)>0.96 && V(QB)<0.24))lfar=ph;
if(!(V(Q)<0.24 && V(QB)>0.96))lnear=ph;
end
end
@(timer(745p,2.5n))$strobe("CORECAP,%d,%.15g,%.15g,%.15g,%.15g",slot,V(PP),V(PN),V(NP),V(NN));
@(timer(985p,2.5n))$strobe("DEADLINE,%d,%.15g,%.15g",slot,V(Q),V(QB));
@(timer(1190p,2.5n))begin
code=0;if(V(Q)>0.96 && V(QB)<0.24)code=1;if(V(Q)<0.24 && V(QB)>0.96)code=-1;
$strobe("RESULT,%d,%.15g,%.15g,%d,%.15g,%.15g",slot,cm,d,code,lfar,lnear);
end
@(timer(2490p,2.5n))begin $strobe("RESET,%d,%.15g,%.15g,%.15g,%.15g,%.15g,%.15g",slot,V(PP),V(PN),V(NP),V(NN),V(Q),V(QB));slot=slot+1;end
end
endmodule
